---
import { Check } from 'lucide-react';
import type { CaseStudy } from '../data/site';

interface Props {
	caseItem: CaseStudy;
}

const { caseItem: c } = Astro.props;
---

<article class="overflow-hidden rounded-[2rem] bg-white shadow-xl shadow-brand-deep/10">
	<div class="grid lg:grid-cols-[0.9fr_1.1fr]">
		<img
			src={c.image}
			alt={`Caso clínico de ${c.patient}, ${c.species.toLowerCase()}`}
			class="h-64 w-full object-cover lg:h-full lg:min-h-[560px]"
			width="900"
			height="1100"
			loading="lazy"
		/>
		<div class="flex flex-col gap-6 p-6 sm:p-10">
			<div class="flex flex-wrap items-center gap-2">
				<span class="rounded-full bg-brand px-3.5 py-1 text-xs font-bold text-white">
					{c.species} · {c.patient}
				</span>
				{c.tags.map((tag) => (
					<span
						key={tag}
						class="rounded-full bg-mint px-3.5 py-1 text-xs font-bold text-ink"
					>
						{tag}
					</span>
				))}
			</div>

			<h3 class="font-display text-2xl font-bold leading-tight tracking-tight text-ink sm:text-3xl">
				{c.title}
			</h3>

			<div>
				<h4 class="text-sm font-bold uppercase tracking-wide text-brand-deep">Protocolo prequirúrgico</h4>
				<p class="mt-2 text-[15px] leading-relaxed text-ink/80">{c.protocol}</p>
			</div>

			<div>
				<h4 class="text-sm font-bold uppercase tracking-wide text-brand-deep">{c.surgeryTitle}</h4>
				<ul class="mt-3 flex flex-col gap-4">
					{c.phases.map((phase, i) => (
						<li class="flex gap-3">
							<span
								class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-deep text-sm font-bold text-white"
								aria-hidden="true"
							>
								{i + 1}
							</span>
							<div>
								<p class="font-bold text-ink">{phase.name}</p>
								<p class="mt-1 text-[15px] leading-relaxed text-ink/80">{phase.description}</p>
							</div>
						</li>
					))}
				</ul>
			</div>

			<div class="flex items-start gap-3 rounded-2xl bg-mint/50 p-4">
				<Check class="mt-0.5 h-5 w-5 shrink-0 text-brand-deep" />
				<p class="text-[15px] font-medium leading-relaxed text-ink">{c.result}</p>
			</div>

			<blockquote class="border-l-4 border-brand pl-4 font-display text-xl font-semibold leading-snug text-brand-deep">
				«{c.quote}»
			</blockquote>
		</div>
	</div>
</article>

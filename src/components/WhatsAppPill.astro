---
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import { site } from '../data/site';

interface Props {
	label?: string;
	href?: string;
	/** brand = petróleo sobre fondos claros, mint = menta sobre fondos oscuros */
	variant?: 'brand' | 'mint';
	size?: 'md' | 'lg';
	class?: string;
}

const {
	label = 'Escríbenos por WhatsApp',
	href = site.whatsapp,
	variant = 'brand',
	size = 'md',
	class: className = '',
} = Astro.props;

const sizeClass = size === 'lg' ? 'px-7 py-3.5 text-base' : 'px-6 py-3 text-sm';
const variantClass =
	variant === 'mint' ? 'bg-mint text-ink' : 'bg-brand-deep text-white shadow-lg shadow-brand-deep/25';
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class:list={[
		'inline-flex items-center gap-2 rounded-full font-bold transition-transform hover:-translate-y-0.5 active:scale-[0.98]',
		sizeClass,
		variantClass,
		className,
	]}
>
	<WhatsAppIcon class="h-5 w-5" />
	{label}
</a>

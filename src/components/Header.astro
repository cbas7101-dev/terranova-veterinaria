---
import MobileNav from './MobileNav.tsx';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import { navLinks, site } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="fixed inset-x-0 top-0 z-40 bg-brand-deep shadow-lg shadow-brand-deep/30">
	<div class="mx-auto flex h-[72px] max-w-[1400px] items-center justify-between gap-4 px-5 sm:px-8">
		<a href="/" class="flex items-center gap-3" aria-label={site.name}>
			<img
				src={site.logo}
				alt={site.logoAlt}
				class="h-12 w-auto max-w-[190px] object-contain"
				width="190"
				height="48"
			/>
			<span class="hidden font-display text-lg font-bold leading-tight text-white sm:block">
				{site.name}
				<span class="block text-xs font-semibold text-white/80">{site.subtitle}</span>
			</span>
		</a>

		<nav aria-label="Principal" class="hidden items-center gap-7 lg:flex">
			{navLinks.map((link) => (
				<a
					href={link.href}
					aria-current={isActive(link.href) ? 'page' : undefined}
					class:list={[
						'text-sm font-semibold transition-colors hover:text-mint',
						isActive(link.href) ? 'text-mint' : 'text-white',
					]}
				>
					{link.label}
				</a>
			))}
		</nav>

		<div class="flex items-center gap-3">
			<a
				href={site.contact.whatsapp}
				target="_blank"
				rel="noopener noreferrer"
				class="hidden items-center gap-2 rounded-full bg-mint px-5 py-2.5 text-sm font-bold text-ink transition-transform hover:-translate-y-0.5 active:scale-[0.98] sm:inline-flex"
			>
				<WhatsAppIcon class="h-4 w-4" />
				WhatsApp
			</a>
			<MobileNav client:load />
		</div>
	</div>
</header>

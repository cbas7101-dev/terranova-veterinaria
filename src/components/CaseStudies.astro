---
import Reveal from './Reveal.tsx';
import CaseCard from './CaseCard.astro';
import { caseStudies } from '../data/site';
---

<section id="casos" class="bg-[#f0faf7] py-20 lg:py-28">
	<div class="mx-auto max-w-[1400px] px-5 sm:px-8">
		<Reveal client:load>
			<div class="max-w-2xl">
				<h2 class="font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
					Casos Clínicos
				</h2>
				<p class="mt-4 text-lg text-gray-600">
					Casos reales de nuestra práctica, contados con transparencia.
				</p>
			</div>
		</Reveal>

		<div class="mt-14 flex flex-col gap-10">
			{caseStudies.map((caseItem) => (
				<Reveal client:load delay={0.1}>
					<CaseCard caseItem={caseItem} />
				</Reveal>
			))}
		</div>
	</div>
</section>
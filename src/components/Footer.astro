---
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
import FacebookIcon from './icons/FacebookIcon.astro';
import { ExternalLink, MapPin, Phone, Mail, Clock } from 'lucide-react';
import { navLinks, site } from '../data/site';

const year = new Date().getFullYear();
const socialIcon = { instagram: InstagramIcon, facebook: FacebookIcon } as const;
---

<footer class="bg-brand-deep">
	<div class="mx-auto max-w-[1400px] px-5 py-16 sm:px-8">
		<div class="grid gap-10 md:grid-cols-3">
			<div>
				<div class="flex items-center gap-3">
					<img
						src={site.logo}
						alt={site.logoAlt}
						class="h-12 w-auto max-w-[190px] rounded-lg bg-white p-1 object-contain"
						width="190"
						height="48"
					/>
				</div>
				<p class="mt-4 max-w-xs text-sm leading-relaxed text-white">
					{site.footer.description}
				</p>
			</div>

			<div>
				<h3 class="text-sm font-bold uppercase tracking-wide text-mint">Navegación</h3>
				<ul class="mt-4 flex flex-col gap-3">
					{navLinks.map((link) => (
						<li>
							<a href={link.href} class="text-sm font-medium text-white transition-colors hover:text-mint">
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<div>
				<h3 class="text-sm font-bold uppercase tracking-wide text-mint">Contacto</h3>
				<ul class="mt-4 flex flex-col gap-3 text-sm text-white">
					<li class="flex gap-2 leading-relaxed">
						<MapPin class="mt-0.5 h-4 w-4 shrink-0" aria-hidden="true" />
						{site.contact.address}
					</li>
					<li>
						<a
							href={site.contact.phoneHref}
							class="inline-flex items-center gap-2 font-medium transition-colors hover:text-mint"
						>
							<Phone class="h-4 w-4" aria-hidden="true" />
							{site.contact.phoneDisplay}
						</a>
					</li>
					<li>
						<a
							href={site.contact.whatsapp}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 font-medium transition-colors hover:text-mint"
						>
							<WhatsAppIcon class="h-4 w-4" />
							{site.contact.whatsappDisplay}
						</a>
					</li>
					<li>
						<a
							href={`mailto:${site.contact.email}`}
							class="inline-flex items-center gap-2 font-medium transition-colors hover:text-mint"
						>
							<Mail class="h-4 w-4" aria-hidden="true" />
							{site.contact.email}
						</a>
					</li>
					{site.contact.schedule.map((line) => (
						<li class="flex gap-2 leading-relaxed text-white/90">
							<Clock class="mt-0.5 h-4 w-4 shrink-0" aria-hidden="true" />
							{line.days}: {line.hours}
						</li>
					))}
					{site.contact.catalogUrl && (
						<li>
							<a
								href={site.contact.catalogUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 font-medium transition-colors hover:text-mint"
							>
								<ExternalLink class="h-4 w-4" aria-hidden="true" />
								Ver catálogo en WhatsApp
							</a>
						</li>
					)}
					{site.contact.socials.length > 0 && (
						<li class="flex gap-4 pt-1">
							{site.contact.socials.map((social) => {
								const Icon = socialIcon[social.id];
								return (
									<a
										href={social.href}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={`${social.id === 'instagram' ? 'Instagram' : 'Facebook'} de ${site.name}`}
										class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
									>
										<Icon class="h-5 w-5" />
									</a>
								);
							})}
						</li>
					)}
				</ul>
			</div>
		</div>

		<div class="mt-12 border-t border-white/20 pt-6">
			<p class="text-sm text-white/80">
				© {year} {site.legalName}. Todos los derechos reservados.
			</p>
		</div>
	</div>
</footer>

---
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
import FacebookIcon from './icons/FacebookIcon.astro';
import { ExternalLink } from 'lucide-react';
import { navLinks, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-brand-deep">
	<div class="mx-auto max-w-[1400px] px-5 py-16 sm:px-8">
		<div class="grid gap-10 md:grid-cols-3">
			<div>
				<div class="flex items-center gap-3">
					<img
						src="/logo.jpeg"
						alt="Logo de la Clínica Veterinaria Terranova"
						class="h-12 w-12 rounded-2xl object-cover"
						width="48"
						height="48"
					/>
					<span class="font-display text-lg font-bold leading-tight text-white">
						Terranova
						<span class="block text-xs font-semibold text-white/80">Servicios Veterinarios</span>
					</span>
				</div>
				<p class="mt-4 max-w-xs text-sm leading-relaxed text-white">
					Clínica, cirugía, laboratorio y Rayos X en Tumbaco, con la única Cat Boutique del país.
				</p>
			</div>

			<div>
				<h3 class="text-sm font-bold uppercase tracking-wide text-mint">Navegación</h3>
				<ul class="mt-4 flex flex-col gap-3">
					{navLinks.map((link) => (
						<li>
							<a href={link.href} class="text-sm font-medium text-white transition-colors hover:text-mint">
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<div>
				<h3 class="text-sm font-bold uppercase tracking-wide text-mint">Contacto</h3>
				<ul class="mt-4 flex flex-col gap-3 text-sm text-white">
					<li class="leading-relaxed">{site.address}</li>
					<li>
						<a
							href={site.whatsapp}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 font-medium transition-colors hover:text-mint"
						>
							<WhatsAppIcon class="h-4 w-4" />
							{site.phoneDisplay}
						</a>
					</li>
					<li>
						<a
							href={site.whatsappCatalog}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 font-medium transition-colors hover:text-mint"
						>
							<ExternalLink class="h-4 w-4" />
							Ver catálogo en WhatsApp
						</a>
					</li>
					<li class="flex gap-4 pt-1">
						<a
							href={site.instagram}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Instagram de Terranova Servicios Veterinarios"
							class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
						>
							<InstagramIcon class="h-5 w-5" />
						</a>
						<a
							href={site.facebook}
							target="_blank"
							rel="noopener noreferrer"
							aria-label="Facebook de Terranova Servicios Veterinarios"
							class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
						>
							<FacebookIcon class="h-5 w-5" />
						</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="mt-12 border-t border-white/20 pt-6">
			<p class="text-sm text-white/80">
				© {year} {site.legalName}. Todos los derechos reservados.
			</p>
		</div>
	</div>
</footer>

---
import Reveal from './Reveal.tsx';
import WhatsAppPill from './WhatsAppPill.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
import FacebookIcon from './icons/FacebookIcon.astro';
import { MapPin, MessageCircle, ExternalLink, ArrowRight, Phone, Mail, Clock } from 'lucide-react';
import { site } from '../data/site';

interface Props {
	/** En el home muestra el resumen con un enlace a la página completa */
	preview?: boolean;
	/** Cuando el bloque abre la página, compensa el header fijo */
	first?: boolean;
}

const { preview = false, first = false } = Astro.props;
const { contact } = site;

const socialIcon = { instagram: InstagramIcon, facebook: FacebookIcon } as const;
---

<section
	class:list={['bg-brand-deep', first ? 'pb-20 pt-[8rem] lg:pb-28 lg:pt-[9rem]' : 'py-20 lg:py-28']}
>
	<div class="mx-auto max-w-[1400px] px-5 sm:px-8">
		<Reveal client:load>
			<div class="max-w-2xl">
				<h2 class="font-display text-4xl font-bold leading-[1.05] tracking-tight text-white sm:text-5xl">
					Ubicación y contacto
				</h2>
				<p class="mt-4 text-lg leading-relaxed text-white">
					{contact.intro}
				</p>
			</div>
		</Reveal>

		<Reveal client:load delay={0.1}>
			<div class="mt-14 grid gap-10 lg:grid-cols-2 lg:gap-16">
				<div class="flex flex-col gap-6">
					<div class="flex gap-4">
						<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/15 text-white">
							<MapPin class="h-6 w-6" />
						</span>
						<div>
							<h3 class="text-lg font-bold text-white">Dirección</h3>
							<p class="mt-1 text-[15px] leading-relaxed text-white">{contact.address}</p>
						</div>
					</div>

					<a href={contact.phoneHref} class="group flex gap-4">
						<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/15 text-white">
							<Phone class="h-6 w-6" />
						</span>
						<div>
							<h3 class="text-lg font-bold text-white group-hover:text-mint">Teléfono</h3>
							<p class="mt-1 text-[15px] text-white">{contact.phoneDisplay}</p>
						</div>
					</a>

					<a
						href={contact.whatsapp}
						target="_blank"
						rel="noopener noreferrer"
						class="group flex gap-4"
					>
						<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/15 text-white">
							<MessageCircle class="h-6 w-6" />
						</span>
						<div>
							<h3 class="text-lg font-bold text-white group-hover:text-mint">WhatsApp</h3>
							<p class="mt-1 text-[15px] text-white">{contact.whatsappDisplay}</p>
						</div>
					</a>

					<a href={`mailto:${contact.email}`} class="group flex gap-4">
						<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/15 text-white">
							<Mail class="h-6 w-6" />
						</span>
						<div>
							<h3 class="text-lg font-bold text-white group-hover:text-mint">Email</h3>
							<p class="mt-1 text-[15px] text-white">{contact.email}</p>
						</div>
					</a>

					<div class="flex gap-4">
						<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/15 text-white">
							<Clock class="h-6 w-6" />
						</span>
						<div>
							<h3 class="text-lg font-bold text-white">Horario</h3>
							{contact.schedule.map((line) => (
								<p class="mt-1 text-[15px] leading-relaxed text-white">
									{line.days}: {line.hours}
								</p>
							))}
						</div>
					</div>

					{contact.socials.map((social) => {
						const Icon = socialIcon[social.id];
						return (
							<a
								href={social.href}
								target="_blank"
								rel="noopener noreferrer"
								class="group flex gap-4"
							>
								<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/15 text-white">
									<Icon class="h-6 w-6" />
								</span>
								<div>
									<h3 class="text-lg font-bold text-white capitalize group-hover:text-mint">
										{social.id}
									</h3>
									<p class="mt-1 text-[15px] text-white">{social.handle}</p>
								</div>
							</a>
						);
					})}

					{contact.catalogUrl && (
						<a
							href={contact.catalogUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="group flex gap-4"
						>
							<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/15 text-white">
								<ExternalLink class="h-6 w-6" />
							</span>
							<div>
								<h3 class="text-lg font-bold text-white group-hover:text-mint">Catálogo de WhatsApp</h3>
								<p class="mt-1 text-[15px] text-white">Productos y servicios a un clic.</p>
							</div>
						</a>
					)}

					<div class="mt-2 flex flex-wrap items-center gap-4">
						<WhatsAppPill variant="mint" label="Escríbenos por WhatsApp" size="lg" />
						{preview && (
							<a
								href="/contacto"
								class="inline-flex items-center gap-2 rounded-full border-2 border-white px-6 py-3 text-sm font-bold text-white transition-transform hover:-translate-y-0.5 active:scale-[0.98]"
							>
								Ver detalle de contacto
								<ArrowRight class="h-4 w-4" />
							</a>
						)}
					</div>
				</div>

				<iframe
					src={contact.mapsEmbed}
					title={contact.mapsTitle}
					class="h-[420px] w-full rounded-[2rem] border-0 shadow-xl shadow-brand-deep/40 lg:h-full lg:min-h-[520px]"
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
					allowfullscreen
				></iframe>
			</div>
		</Reveal>
	</div>
</section>

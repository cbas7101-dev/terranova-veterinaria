---
import Reveal from './Reveal.tsx';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
import FacebookIcon from './icons/FacebookIcon.astro';
import { MapPin, MessageCircle, ExternalLink } from 'lucide-react';
import { site } from '../data/site';
---

<section id="contacto" class="bg-white py-20 lg:py-28">
	<div class="mx-auto max-w-[1400px] px-5 sm:px-8">
		<Reveal client:load>
			<div class="max-w-2xl">
				<h2 class="font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
					Ubicación y contacto
				</h2>
				<p class="mt-4 text-lg text-gray-600">
					Visítanos en Tumbaco o escríbenos por cualquiera de nuestros canales.
				</p>
			</div>
		</Reveal>

		<Reveal client:load delay={0.1}>
			<div class="mt-14 grid gap-10 lg:grid-cols-2 lg:gap-16">
				<div class="flex flex-col gap-6">
					<div class="flex gap-4">
						<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-mint/40 text-brand-deep">
							<MapPin class="h-6 w-6" />
						</span>
						<div>
							<h3 class="text-lg font-bold text-ink">Dirección</h3>
							<p class="mt-1 text-[15px] leading-relaxed text-gray-600">{site.address}</p>
						</div>
					</div>

					<a
						href={site.whatsapp}
						target="_blank"
						rel="noopener noreferrer"
						class="group flex gap-4"
					>
						<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-mint/40 text-brand-deep">
							<MessageCircle class="h-6 w-6" />
						</span>
						<div>
							<h3 class="text-lg font-bold text-ink group-hover:text-brand-deep">WhatsApp</h3>
							<p class="mt-1 text-[15px] text-gray-600">{site.phoneDisplay}</p>
						</div>
					</a>

					<a
						href={site.instagram}
						target="_blank"
						rel="noopener noreferrer"
						class="group flex gap-4"
					>
						<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-mint/40 text-brand-deep">
							<InstagramIcon class="h-6 w-6" />
						</span>
						<div>
							<h3 class="text-lg font-bold text-ink group-hover:text-brand-deep">Instagram</h3>
							<p class="mt-1 text-[15px] text-gray-600">@terranovaservet</p>
						</div>
					</a>

					<a
						href={site.facebook}
						target="_blank"
						rel="noopener noreferrer"
						class="group flex gap-4"
					>
						<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-mint/40 text-brand-deep">
							<FacebookIcon class="h-6 w-6" />
						</span>
						<div>
							<h3 class="text-lg font-bold text-ink group-hover:text-brand-deep">Facebook</h3>
							<p class="mt-1 text-[15px] text-gray-600">Terranova Servicios Veterinarios</p>
						</div>
					</a>

					<div class="mt-2 flex flex-wrap gap-3">
						<a
							href={site.whatsapp}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 rounded-full bg-brand px-6 py-3.5 text-base font-semibold text-white transition-transform hover:-translate-y-0.5 active:scale-[0.98]"
						>
							<WhatsAppIcon class="h-5 w-5" />
							Escríbenos por WhatsApp
						</a>
						<a
							href={site.whatsappCatalog}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 rounded-full border-2 border-brand px-6 py-3.5 text-base font-semibold text-brand transition-transform hover:-translate-y-0.5 active:scale-[0.98]"
						>
							<ExternalLink class="h-5 w-5" />
							Ver catálogo en WhatsApp
						</a>
					</div>
				</div>

				<iframe
					src={site.mapsEmbed}
					title="Mapa de la Clínica Veterinaria Terranova en Tumbaco"
					class="h-[420px] w-full rounded-[2rem] border-0 shadow-lg shadow-brand-deep/10 lg:h-full lg:min-h-[520px]"
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
					allowfullscreen
				></iframe>
			</div>
		</Reveal>
	</div>
</section>
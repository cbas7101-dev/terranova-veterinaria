---
import '@fontsource-variable/fredoka';
import '@fontsource-variable/outfit';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Terranova Servicios Veterinarios | Clínica Veterinaria en Tumbaco',
	description = 'Clínica Veterinaria Terranova: consultas, cirugía, emergencias, laboratorio hematológico y Rayos X de última generación, con la única Cat Boutique del país. Tumbaco, Ecuador.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#2e9689" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content="/logo.jpeg" />
	</head>
	<body class="bg-white font-body text-ink">
		<slot />
	</body>
</html>

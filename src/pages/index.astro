---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ServicesSection from '../components/ServicesSection.astro';
import AboutBlock from '../components/AboutBlock.astro';
import CasesBlock from '../components/CasesBlock.astro';
import ContactBlock from '../components/ContactBlock.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<Layout>
	<Header />
	<main>
		<Hero />
		<ServicesSection title="Servicios" level="h2" topOffset={false} showLink />
		<AboutBlock preview />
		{site.cases.enabled && <CasesBlock preview />}
		<ContactBlock preview />
	</main>
	<Footer />
</Layout>

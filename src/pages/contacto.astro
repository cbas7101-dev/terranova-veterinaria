---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ContactBlock from '../components/ContactBlock.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<Layout
	title={`Contacto y ubicación | ${site.name}`}
	description={`${site.contact.intro} ${site.contact.address}. Teléfono ${site.contact.phoneDisplay}, WhatsApp ${site.contact.whatsappDisplay}.`}
>
	<Header />
	<main>
		<ContactBlock first />
	</main>
	<Footer />
</Layout>
